    object btnUnloadCover: TButton
      Hint = 
        'Downloads are active. Open this cover to expose Unload or Uninit' +
        'ialize, then press that button deliberately. Unloading can inval' +
        'idate the active TLS objects; this demo permits the experiment.'
      Position.X = 184.000000000000000000
      Position.Y = 180.000000000000000000
      Size.Width = 220.000000000000000000
      Size.Height = 36.000000000000000000
      Size.PlatformDefault = False
      TabOrder = 1
      Text = 'Open cover to unload'
      Visible = False
      ParentShowHint = False
      ShowHint = True
      OnClick = OpenUnloadCover
    end
    object btnCloseCover: TButton
      Hint = 
        'Cover the unload action again without changing the OpenSSL loade' +
        'r or cancelling downloads. The cover also closes after use or wh' +
        'en the active download count changes.'
      Position.X = 416.000000000000000000
      Position.Y = 180.000000000000000000
      Size.Width = 124.000000000000000000
      Size.Height = 36.000000000000000000
      Size.PlatformDefault = False
      TabOrder = 4
      Text = 'Close cover'
      Visible = False
      ParentShowHint = False
      ShowHint = True
      OnClick = CloseUnloadCover
    end
