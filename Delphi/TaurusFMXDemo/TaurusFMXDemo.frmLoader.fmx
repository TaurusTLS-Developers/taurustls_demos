object frmLoader: TfrmLoader
  Size.Width = 860.000000000000000000
  Size.Height = 680.000000000000000000
  Size.PlatformDefault = False
  object LoaderScroll: TScrollBox
    Align = Client
    Hint = 
      'Scroll to inspect configuration, runtime information, saved desi' +
      'gn settings and the lifecycle result log.'
    Size.Width = 860.000000000000000000
    Size.Height = 680.000000000000000000
    Size.PlatformDefault = False
    TabOrder = 0
    ParentShowHint = False
    ShowHint = True
    Viewport.Width = 844.000000000000000000
    Viewport.Height = 680.000000000000000000
    object grpConfiguration: TGroupBox
      Hint = 
        'Pending loader settings. Configuration is editable while inactiv' +
        'e; library paths and suffixes are additionally limited to dynami' +
        'c linking.'
      Position.X = 12.000000000000000000
      Position.Y = 12.000000000000000000
      Size.Width = 818.000000000000000000
      Size.Height = 156.000000000000000000
      Size.PlatformDefault = False
      Text = 'Configuration - editable while inactive'
      TabOrder = 0
      ParentShowHint = False
      ShowHint = True
      object lblLibraryPath: TLabel
        Hint = 
          'OpenSSL library search directory for dynamic linking. Edit while' +
          ' the loader is inactive; the value is a search directory, not th' +
          'e resolved filename of a loaded library. Static targets keep thi' +
          's field read-only.'
        HitTest = True
        Position.X = 12.000000000000000000
        Position.Y = 32.000000000000000000
        Size.Width = 150.000000000000000000
        Size.Height = 24.000000000000000000
        Size.PlatformDefault = False
        TextSettings.WordWrap = False
        Text = 'Library search directory'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 3
      end
      object edtLibraryPath: TEdit
        Touch.InteractiveGestures = [LongTap, DoubleTap]
        TabOrder = 0
        KeyboardType = URL
        Position.X = 172.000000000000000000
        Position.Y = 28.000000000000000000
        Hint = 
          'OpenSSL library search directory for dynamic linking. Edit while' +
          ' the loader is inactive; the value is a search directory, not th' +
          'e resolved filename of a loaded library. Static targets keep thi' +
          's field read-only.'
        Size.Width = 626.000000000000000000
        Size.Height = 30.000000000000000000
        Size.PlatformDefault = False
        ParentShowHint = False
        ShowHint = True
        object btnLibraryPath: TEllipsesEditButton
          Touch.InteractiveGestures = [LongTap]
          CanFocus = False
          Cursor = crArrow
          Hint = 
            'Choose an OpenSSL library search directory. This only changes pe' +
            'nding text; use Load to apply it while inactive.'
          Size.Width = 30.000000000000000000
          Size.Height = 26.000000000000000000
          Size.PlatformDefault = False
          TabOrder = 0
          ParentShowHint = False
          ShowHint = True
          OnClick = BrowseLibraryPath
        end
      end
      object lblConfigFile: TLabel
        Hint = 
          'OpenSSL configuration filename. Edit while inactive; pending tex' +
          't is applied when you load or initialize OpenSSL. While ready, t' +
          'he displayed value can be the effective configuration filename.'
        HitTest = True
        Position.X = 12.000000000000000000
        Position.Y = 72.000000000000000000
        Size.Width = 150.000000000000000000
        Size.Height = 24.000000000000000000
        Size.PlatformDefault = False
