        Size.Height = 30.000000000000000000
        Size.PlatformDefault = False
        ParentShowHint = False
        ShowHint = True
        object btnConfigFile: TEllipsesEditButton
          Touch.InteractiveGestures = [LongTap]
          CanFocus = False
          Cursor = crArrow
          Hint = 
            'Choose an OpenSSL configuration file. This only changes pending ' +
