  object dlgConfigFile: TOpenDialog
    Filter = 
      'OpenSSL configuration (*.cnf;*.conf)|*.cnf;*.conf|All files (*.*' +
      ')|*.*'
    Options = [ofNoChangeDir, ofPathMustExist, ofFileMustExist, ofEnableSizing]
    Title = 'Select OpenSSL configuration file'
    Left = 112
    Top = 312
  end
  object LoaderActions: TActionList
    OnUpdate = LoaderActionsUpdate
    Left = 64
    Top = 312
    object actToggleLoader: TAction
      Text = 'Load'
      Hint = 
        'Load or unload the shared OpenSSL libraries on dynamic targets; ' +
        'initialize or uninitialize on static targets. After a failed loa' +
        'd, use the reset action before retrying.'
      OnExecute = ToggleLoader
      OnUpdate = PollLoader
    end
  end
end
