      ExplicitSize.cx = 50.000000000000000000
      ExplicitSize.cy = 50.000000000000000000
      object memCertificates: TMemo
        Touch.InteractiveGestures = [Pan, LongTap, DoubleTap]
        DataDetectorTypes = []
        ReadOnly = True
        Align = Client
        Hint = 
          'Certificate details captured during TLS verification, followed b' +
          'y the server-sent chain after a successful handshake. A sent cha' +
          'in need not include the root CA. Plain HTTP and FTP have no TLS ' +
          'certificates; an early handshake failure may leave this view emp' +
          'ty.'
        Size.Width = 776.000000000000000000
        Size.Height = 259.000000000000000000
        Size.PlatformDefault = False
        TabOrder = 0
        ParentShowHint = False
        ShowHint = True
        Viewport.Width = 776.000000000000000000
        Viewport.Height = 259.000000000000000000
      end
    end
