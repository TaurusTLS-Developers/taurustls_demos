  object SessionCommands: TLayout
    Align = Right
    Hint = 
      'Cancel an active session, clear a finished result, or expand its' +
      ' diagnostic details.'
    Margins.Left = 12.000000000000000000
    Position.X = 692.000000000000000000
    Position.Y = 8.000000000000000000
    Size.Width = 96.000000000000000000
    Size.Height = 140.000000000000000000
    Size.PlatformDefault = False
    ParentShowHint = False
    ShowHint = True
    object btnCancel: TButton
      Align = Top
      Hint = 
        'While active, request cooperative cancellation; network operatio' +
        'ns may take time to return. After worker cleanup, Clear removes ' +
        'this row and its diagnostics. It never deletes the downloaded de' +
        'stination file.'
      Size.Width = 96.000000000000000000
      Size.Height = 28.000000000000000000
      Size.PlatformDefault = False
      Text = 'Cancel'
      ParentShowHint = False
      ShowHint = True
      OnClick = CancelClick
    end
    object btnDetails: TButton
      StyledSettings = [Family, Style, FontColor, Other]
      Hint = 
        'Expand or collapse this session'#39's transfer log and server certif' +
        'icate-chain details. The chevron indicates whether details will ' +
        'open or close.'
      Position.X = 64.000000000000000000
      Position.Y = 36.000000000000000000
      Size.Width = 32.000000000000000000
      Size.Height = 24.000000000000000000
      Size.PlatformDefault = False
      ParentShowHint = False
      ShowHint = True
      OnClick = DetailsClick
      object pathDetails: TPath
        Align = Center
        Data.Path = {
          07000000000000000000000000000000010000000000E0400000A04001000000
          0000604100000000010000000000604100004040010000000000E04000000041
          010000000000000000004040030000000000000000000000}
        Fill.Color = claGray
        HitTest = False
        Size.Width = 14.000000000000000000
        Size.Height = 8.000000000000000000
        Size.PlatformDefault = False
        Stroke.Kind = None
      end
    end
    object progressUnknown: TAniIndicator
      Hint = 
