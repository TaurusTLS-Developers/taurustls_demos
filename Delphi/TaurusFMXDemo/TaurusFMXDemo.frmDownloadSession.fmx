      Position.Y = 72.000000000000000000
      Size.Width = 28.000000000000000000
      Size.Height = 28.000000000000000000
      Size.PlatformDefault = False
      Visible = False
      ParentShowHint = False
      ShowHint = True
    end
  end
  object SessionContent: TLayout
    Align = Client
    Hint = 
      'Summary of this download: source URL, destination, received byte' +
      's and current result.'
    Size.Width = 668.000000000000000000
    Size.Height = 140.000000000000000000
    Size.PlatformDefault = False
    ParentShowHint = False
    ShowHint = True
    object lblURL: TLabel
      Align = Top
      Hint = 
        'Download'#39's original URL, shortened in the middle when necessary.' +
        ' Right-click and choose Copy full URL to copy the complete addre' +
        'ss.'
      HitTest = True
      PopupMenu = CopyMenu
      Size.Width = 668.000000000000000000
      Size.Height = 24.000000000000000000
      Size.PlatformDefault = False
      TextSettings.WordWrap = False
      Text = 'URL'
      ParentShowHint = False
      ShowHint = True
    end
    object lblFilename: TLabel
      Align = Top
      Hint = 
        'Local destination filename, shortened in the middle when necessa' +
        'ry. Right-click and choose Copy full filename for the complete p' +
        'ath.'
      HitTest = True
      PopupMenu = CopyMenu
      Position.Y = 24.000000000000000000
      Size.Width = 668.000000000000000000
      Size.Height = 24.000000000000000000
      Size.PlatformDefault = False
      TextSettings.WordWrap = False
      Text = 'Filename'
      ParentShowHint = False
      ShowHint = True
    end
    object lblProgress: TLabel
      Align = Top
      Hint = 
        'Actual bytes written to the temporary download file. A percentag' +
        'e is shown only when the total size is known; total unknown does' +
        ' not mean the transfer has stalled.'
      HitTest = True
      Position.Y = 48.000000000000000000
      Size.Width = 668.000000000000000000
      Size.Height = 24.000000000000000000
      Size.PlatformDefault = False
      TextSettings.WordWrap = False
      Text = '0 B received / total unknown'
      ParentShowHint = False
      ShowHint = True
    end
    object barProgress: TProgressBar
      Align = Top
      Hint = 
        'Progress from actual received bytes and the reported total. Hidd' +
        'en while the total is unknown. The final destination is publishe' +
        'd only after a successful transfer.'
      Orientation = Horizontal
      Position.Y = 72.000000000000000000
      Size.Width = 668.000000000000000000
      Size.Height = 16.000000000000000000
      Size.PlatformDefault = False
      ParentShowHint = False
      ShowHint = True
    end
    object lblStatus: TLabel
      Align = Top
      Hint = 
        'Current session state and any original exception class and messa' +
        'ge. Completed is green; Failed is red. Right-click to copy the f' +
        'ull status.'
      HitTest = True
      PopupMenu = CopyMenu
      Position.Y = 88.000000000000000000
      Size.Width = 668.000000000000000000
      Size.Height = 24.000000000000000000
      Size.PlatformDefault = False
      TextSettings.VertAlign = Leading
      Text = 'Queued'
      ParentShowHint = False
      ShowHint = True
    end
  end
  object CopyMenu: TPopupMenu
    object mnuCopyURL: TMenuItem
      Text = 'Copy full URL'
      OnClick = CopyURLClick
    end
    object mnuCopyFilename: TMenuItem
      Text = 'Copy full filename'
      OnClick = CopyFilenameClick
    end
    object mnuCopyStatus: TMenuItem
      Text = 'Copy status'
      OnClick = CopyStatusClick
    end
  end
